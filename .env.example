# Optional command that reads one JSON request on stdin and writes the pinned
# candidate-roster JSON transcription on stdout.
WIFE_ROSTER_TRANSCRIBER=

# Optional private database override. Production defaults to Application Support.
WIFE_ROSTER_DB=

# Optional absolute roster executable override used in the launchd plist.
# The project-local .venv/bin/roster is preferred automatically when present.
WIFE_ROSTER_COMMAND=

# Optional production runtime root. Leave blank to use the platform default.
WIFE_ROSTER_DEPLOY_ROOT=

# Delivery is fail-closed and never inferred from available credentials.
# Keep Console for a fresh installation; production selection is explicit.
WIFE_ROSTER_NOTIFIER=console

# Intended OpenClaw direct-delivery adapter. Leave the target blank until the
# controlled live-testing stage.
WIFE_ROSTER_OPENCLAW_BIN=~/.openclaw/bin/openclaw
WIFE_ROSTER_OPENCLAW_ACCOUNT=
WIFE_ROSTER_OPENCLAW_TARGET=

# Inactive direct Telegram fallback. Keep real values only in the production
# .env and select it only with WIFE_ROSTER_NOTIFIER=telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Thin inbound OpenClaw hook. Configure only in the protected production .env;
# never guess sender IDs or use a wildcard group/sender value.
WIFE_ROSTER_INBOUND_GROUP_ID=
WIFE_ROSTER_INBOUND_ALLOWED_SENDERS=
# Separate server-side allowlist for Approve/Revise. List both spouses here only
# when both are intentionally authorized; keep numeric IDs out of source control.
WIFE_ROSTER_STATE_CHANGE_ALLOWED_SENDERS=
# Optional override; defaults to runtime/private/inbox under the deploy root.
WIFE_ROSTER_INBOX=
